+static uint32_t transport_config_check_rate(struct impl *this, uint32_t rate,
+		bool *allowed)
+{
+	uint8_t buffer[1024];
+	struct spa_pod_builder b = SPA_POD_BUILDER_INIT(buffer, sizeof(buffer));
+	struct spa_pod *param = NULL;
+	struct spa_pod_object *obj;
+	const struct spa_pod_prop *prop;
+	const struct spa_pod *val;
+	const int32_t *rates;
+	uint32_t n_vals, choice, first = 0;
+	int res;
+
+	*allowed = true;
+
+	if (!transport_is_current(this) || this->transport->configuration == NULL ||
+			this->codec == NULL || this->codec->enum_config == NULL)
+		return 0;
+
+	res = this->codec->enum_config(this->codec,
+			this->is_duplex ? MEDIA_CODEC_FLAG_SINK : 0,
+			this->transport->configuration,
+			this->transport->configuration_len,
+			SPA_PARAM_EnumFormat, 0, &b, &param);
+	if (res <= 0 || param == NULL ||
+			!spa_pod_is_object_type(param, SPA_TYPE_OBJECT_Format))
+		return 0;
+
+	obj = (struct spa_pod_object *) param;
+	prop = spa_pod_object_find_prop(obj, NULL, SPA_FORMAT_AUDIO_rate);
+	if (prop == NULL)
+		return 0;
+
+	val = spa_pod_get_values(&prop->value, &n_vals, &choice);
+	if (n_vals == 0 || val->type != SPA_TYPE_Int)
+		return 0;
+
+	rates = SPA_POD_BODY(val);
+	first = rates[0] > 0 ? (uint32_t) rates[0] : 0;
+	*allowed = false;
+	for (uint32_t i = 0; i < n_vals; ++i)
+		if (rates[i] > 0 && (uint32_t) rates[i] == rate)
+			*allowed = true;
