+    // Reproducible builds: use a previously extracted tables file instead of the
+    // vendor encoder library, so the build needs no external .so at all.
+    if let Some(tables) = env::var_os("APTX_ADAPTIVE_TABLES") {
+        println!("cargo::rerun-if-env-changed=APTX_ADAPTIVE_TABLES");
+        let src = PathBuf::from(tables);
+        let text = fs::read_to_string(&src)
+            .map_err(|e| format!("can't read {}: {e}", src.display()))?;
+        let out = PathBuf::from(
+            env::var("OUT_DIR").map_err(|e| format!("OUT_DIR: {e}"))?,
+        )
+        .join("tables.rs");
+        fs::write(&out, text)
+            .map_err(|e| format!("can't write {}: {e}", out.display()))?;
+        return Ok(());
+    }
