   box-shadow: inset 0 0 0 1px rgba(151, 169, 216, 0.18);
 }
 
+/* Tool/command/think/context disclosure surfaces stay translucent so the
+   character backdrop reads through them. Blur what is sampled underneath the
+   translucent wash: without it the navy-blue UI text sits directly on busy
+   palace art of the same hue. The header inside an expanded container keeps
+   `backdrop-filter: none` below and relies on its parent's single blur layer
+   (nested backdrop filters would double-sample the backdrop). */
+body[data-dsh-maid-atelier]
+  :is(
+    [data-variant] > [data-open='true'],
+    [data-chat-flow-kind='context'] > [data-slot='conversation.chat.node'] > [data-open='true']
+  ) {
+  backdrop-filter: blur(12px) saturate(0.92);
+  -webkit-backdrop-filter: blur(12px) saturate(0.92);
+}
+
+/* Collapsed rows have no expanded container, so each row blurs its own strip.
+   `:not([data-open='true'])` keeps the already-covered in-card header alone. */
+body[data-dsh-maid-atelier]
+  :is(
+    [data-variant] > :not([data-open='true']),
+    [data-chat-flow-kind='context'] > [data-slot='conversation.chat.node'] > :not([data-open='true'])
+  ) > [data-disclosure-row='true'] {
+  backdrop-filter: blur(8px) saturate(0.92);
+  -webkit-backdrop-filter: blur(8px) saturate(0.92);
+}
+
+/* The bash toolview registers its own row without the shared DisclosureRow
+   (data-variant='bash' IS the single-line row itself). Its collapsed state is
+   transparent over the palace art, so blur that strip directly; the expanded
+   terminal/IO card below stays opaque and needs no filter. */
+body[data-dsh-maid-atelier] [data-variant='bash'] {
+  backdrop-filter: blur(8px) saturate(0.92);
+  -webkit-backdrop-filter: blur(8px) saturate(0.92);
+}
+
