+        const callEvent = session.append('tool/call', { turn: 1, step: 1, callId: 'call-1' as CallId, name: 'bash', arguments: '{"command":"ls"}' })
+        session.append('tool/result', {
+          turn: 1, step: 1,
+          message: createToolResultMessage({ callId: 'call-1' as CallId, content: [{ type: 'text', text: 'ok' }], isError: false }),
+        }, { surfaceOp: 'append', sourceEventSeqs: [callEvent.seq] })
+        session.append('assistant/message', {
+          turn: 1, step: 1,
+          message: createAssistantMessage({
+            content: [{ type: 'text', text: 'Hello' }],
+            source: { provider: 'test-provider', model: 'test-model' },
+          }),
+        }, { surfaceOp: 'append' })
