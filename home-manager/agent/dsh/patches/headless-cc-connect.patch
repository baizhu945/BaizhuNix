+
+  // [cc-connect --jsonl] Approval requests must stream to stdout and the
+  // runner must resolve the pending request from an approval/response line
+  // on stdin (the driver relays the human's Feishu card decision). The
+  // answerer subscribes to the scoped 'approval/request' waterfall.
+  it('[cc-connect] --jsonl relays approval requests and resolves from stdin', async () => {
+    const { PassThrough } = await import('node:stream')
+    const stdin = new PassThrough()
+    const approvalLines: string[] = []
+    let theCtx: Context | undefined
+    const test = await bench({
+      onStdout(chunk) {
+        // The driver answers the approval request the moment it streams out.
+        if (chunk.includes('"type":"approval/request"')) {
+          approvalLines.push(chunk.trim())
+          const id = (JSON.parse(chunk) as { id: string }).id
+          stdin.write(`${JSON.stringify({ type: 'approval/response', id, outcome: 'allowed-once' })}\n`)
+        }
+      },
+      async afterPrompt(session, message) {
+        // The runner registered its answerer on the ctx event system; trigger
+        // an approval request the way the approval seam does.
+        (theCtx!.emit as unknown as (name: string, ...args: unknown[]) => unknown)(
+          'approval/request',
+          { toolName: 'bash', reason: 'approve me' },
+          () => Promise.resolve('unavailable'),
+        )
+        await Promise.resolve()
+        appendTurn(session, 1, message, 'approved-answer', true)
+      },
+    }, { stdin })
+    theCtx = test.ctx
+    const result = await test.run({ jsonl: true, mode: 'confirm' })
+    expect(result.code).toBe(0)
+    expect(approvalLines.length).toBe(1)
+    expect(JSON.parse(approvalLines[0]!)).toMatchObject({ type: 'approval/request', toolName: 'bash', reason: 'approve me' })
+    expect(result.out).toContain('"type":"result"')
+    stdin.destroy()
+    await test.ctx.fiber.dispose()
+  })
 })
