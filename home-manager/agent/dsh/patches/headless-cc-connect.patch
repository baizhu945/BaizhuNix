+    }, { stdin })
+    const result = await test.run({ jsonl: true })
+    expect(result.code).toBe(0)
+    expect(result.err).toBe('')
+    const lines = result.out.split('\n').filter(l => l !== '')
+    const types = lines.map(l => JSON.parse(l).type)
+    expect(types).toEqual(['text', 'text', 'tool/call', 'tool/result', 'result', 'done'])
+    expect(JSON.parse(lines[2]!)).toMatchObject({ type: 'tool/call', name: 'bash', callId: 'call-1', arguments: '{"command":"ls"}' })
+    expect(JSON.parse(lines[3]!)).toMatchObject({ type: 'tool/result', name: 'bash', content: 'ok' })
