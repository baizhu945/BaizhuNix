diff -u -N --recursive a/preset/vision-routing.mjs b/preset/vision-routing.mjs
--- a/preset/vision-routing.mjs
+++ b/preset/vision-routing.mjs
@@ -0,0 +1,73 @@
+/**
+ * Vision fallback routing — append the vision fallback guidance to the persona
+ * ONLY after the anchored session has promoted, so request #1 keeps the
+ * upstream Minimal-aligned bootstrap exactly: the rendered persona, the
+ * two-tool catalog, and the suppressed workspace/skill injections are all
+ * unchanged while the session is unpromoted.
+ *
+ * `@deepseek-ai/dsh-persona` registers `deployment:persona` as a complete
+ * system prompt, so an extra prompt section would be discarded; instead this
+ * plugin registers a prompt variable referenced by the persona template. The
+ * variable renders as the empty string during bootstrap and as the guidance
+ * text after the session's first durable promotion signal. The promotion test
+ * mirrors ./tool-bootstrap.mjs — keep both `promoteOn` values in sync.
+ *
+ * @module anchored-vision-routing (local preset plugin)
+ */
+
+export const name = 'anchored-vision-routing'
+
+/** The prompt registry this plugin contributes a variable to. */
+export const inject = ['systemPrompt']
+
+/** Durable session event types that count as a promotion signal per mode. */
+const PROMOTE_EVENTS = {
+  'tool-call': ['tool/call'],
+  'assistant-message': ['assistant/message'],
+  either: ['tool/call', 'assistant/message'],
+}
+
+/**
+ * Guidance appended to the rendered persona after promotion. It starts with a
+ * blank line because the persona template references `{{vision_routing}}`
+ * immediately after the upstream one-liner.
+ */
+const VISION_ROUTING = '\n\n'
+  + 'Vision fallback: you may be running on a model that cannot see images. '
+  + "When the user's task involves an image by file path — a screenshot, chart, document photo, or any image on disk — do not read the image yourself. "
+  + 'Call the `vision` tool in the foreground with a short `description` and a self-contained `prompt` that includes the absolute image path and the exact question to answer. '
+  + 'If only a filename or directory is given, locate the file with `glob`/`grep` first, then delegate the resolved path. '
+  + 'Relay the returned text description to the user. '
+  + 'If your model supports image input, prefer `read_image` directly.'
+
+function parsePromoteOn(value) {
+  if (value === undefined || value === 'either') return PROMOTE_EVENTS.either
+  if (value === 'tool-call' || value === 'assistant-message') return PROMOTE_EVENTS[value]
+  throw new TypeError(`${name}: promoteOn must be one of "tool-call", "assistant-message", "either"; got ${JSON.stringify(value)}`)
+}
+
+export function apply(ctx, config) {
+  const promoteEvents = parsePromoteOn(config.promoteOn)
+
+  /** Sessions already promoted in this process. Promotion is append-only, so a Set is sound. */
+  const promoted = new Set()
+
+  /**
+   * Whether the session has reached the promoted phase — the same durable
+   * event test used by ./tool-bootstrap.mjs, so the vision routing text and
+   * the full Standard tool catalog open together.
+   * @param agent - the assembly context's agent, or undefined outside an agent.
+   */
+  const isPromoted = (agent) => {
+    if (agent === undefined) return true
+    const session = agent.session
+    if (session === undefined) return true
+    if (promoted.has(session.id)) return true
+    const hit = session.events.some((event) => promoteEvents.includes(event.type))
+    if (hit) promoted.add(session.id)
+    return hit
+  }
+
+  ctx.systemPrompt.variable('vision_routing', (context) =>
+    isPromoted(context.agent) ? VISION_ROUTING : '')
+}
